    "optical": {
      "edge": "a line's left edge is the mean of its first letter's left ink profile over the cap height; lines of one block align on it"
    },
    "lockup": {
      "mark_lines": 5,
      "descriptor": "name size / r\u2074",
      "tight": 0.4,
      "rule": "the mark is as tall as the text beside it (the name's capitals to the descriptor's baseline); the descriptor sits tight under the name (white space \u2248 0.4 \u00d7 the name's size, just over a display line's own gap); between mark and name, whole columns",
      "descriptor_over_name": 0.2459,
      "name_size_over_mark": 0.7648
    },
    "principles": [
      "Proximity: what belongs together sits closer than what does not; a heading sits closer to what it introduces than to what came before.",
      "Space follows the type: the white space under a display line is set from its size (tight: \u2248 0.4 \u00d7), not from a fixed row.",
      "Leading: display type at 1.0\u20131.15, text at \u2248 1.5; every leading and every space a multiple of a quarter line.",
      "One block, one alignment: elements that belong together share an edge (a column start, a cap height, a baseline).",
      "A kicker (the label voice) stands above what it names, never trailing below it; no line repeats another.",
      "Optics over boxes: align ink, not bounding boxes, and ink where the eye reads it: a line's edge is the mean of its first letter's left profile, so a T hangs its arm into the margin (the eye reads its stem) and an A its foot."
    ]
  }
